{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": false,
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "types": ["node"],
    "skipLibCheck": true,

    "ignoreDeprecations": "6.0"
  },
  "include": ["src/handlers/*.handler.ts", "src/middlewares/*.middleware.ts", "src"]
}
